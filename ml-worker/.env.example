# Sentri Worker Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text  # Options: text, json
LOG_FILE=

# OCR Configuration
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_TIMEOUT=30
TESSERACT_CMD=/usr/bin/tesseract

# Parser Configuration
PARSER_FALLBACK=true
PARSER_MIN_CONFIDENCE=0.5
PARSER_STRICT=false

# Cache Configuration
CACHE_ENABLED=true
CACHE_MAXSIZE=256
CACHE_TTL=3600  # Time-to-live in seconds (1 hour)

# Worker Configuration
MAX_WORKERS=4
WORKER_TIMEOUT=300  # Timeout in seconds (5 minutes)

# Performance Monitoring
ENABLE_METRICS=true
ENABLE_PROFILING=false

# Development Settings
DEBUG=false
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
